# -------------------------------------------------------------
# TUTORON INDIA - ENVIRONMENT CONFIGURATION TEMPLATE
# -------------------------------------------------------------

# Application Security
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database (PostgreSQL in production, SQLite fallback in local dev)
DATABASE_URL=postgres://tutoron_user:tutoron_password@localhost:5432/tutoron_db

# SimpleJWT Authentication
JWT_ACCESS_MINUTES=1440
JWT_REFRESH_DAYS=7

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Gateway (Console backend in dev, SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=admin@tutoron.in
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TutorOn India <noreply@tutoron.in>

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# AWS S3 Storage (Optional in Production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# Payment Gateway (Phase 2 - Razorpay/Sandbox)
PAYMENT_PROVIDER=sandbox
PAYMENT_KEY=rzp_test_samplekey123
PAYMENT_SECRET=sample_secret_key_456

# Media Upload Limits (Bytes)
MAX_VIDEO_UPLOAD_SIZE=524288000
MAX_DOCUMENT_UPLOAD_SIZE=20971520
